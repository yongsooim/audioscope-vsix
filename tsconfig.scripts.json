{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2024",
    "lib": [
      "ES2024"
    ],
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "scripts/**/*.mts"
  ]
}
